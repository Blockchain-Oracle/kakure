{
  "name": "@kakure/arcade-server",
  "private": true,
  "type": "module",
  "description": "Kakure's arcade service: issues runs with their real-price tapes, replays every score before it ranks, keeps nickname boards. Reached only through the site worker's /arcade/ path.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@kakure/arcade": "workspace:*",
    "@kakure/domain": "workspace:*",
    "@kakure/ecash": "workspace:*",
    "@kakure/signing": "workspace:*",
    "@noble/hashes": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
