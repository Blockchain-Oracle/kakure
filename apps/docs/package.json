{
  "name": "@kakure/docs",
  "private": true,
  "type": "module",
  "description": "Kakure's docs: a static Fumadocs site for docs.getkakure.xyz, with offline search and Mermaid system maps.",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build && node scripts/offline.mjs",
    "serve": "node scripts/serve.mjs",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@kakure/query": "workspace:*",
    "@kakure/tokens": "workspace:*",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "mermaid": "12.2.0",
    "next": "catalog:",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
